{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ga5-incident-agent",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "IncidentRun" }]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IncidentRun"] }],
  "vars": {
    "LLM_BASE_URL": "https://aipipe.org/openai/v1",
    "LLM_MODEL": "gpt-4.1-mini",
    "LLM_TIMEOUT_MS": "14000"
  }
  // LLM_API_KEY is a SECRET: set it in the dashboard (Settings > Variables and Secrets), never here.
}
